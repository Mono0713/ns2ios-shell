# Not part of the fork: the shader chain lock and the per-profile chain header are rewritten by dmsh_chain.py
# (--update-lock / --header) on every machine that runs the packing chain. Upstream versions stay as they are.
__pycache__/
*.pyc
dm/ios/Gen/

# This repository is public. Game files and keys must never be committed, whatever a packing run leaves behind
# in the tree. The shell carries no game content by design, so none of these are ever needed here.
*.nsp
*.xci
*.nsz
*.xcz
*.nca
*.ncz
*.tik
*.keys
prod.keys
console.keys
*.ipa
*.xip
data/
out/
built/
work/

# Upstream's own CI. Two of its four jobs compile the Mac packing and checking chain this fork leaves out on purpose
# (dm/ios/tools/compile_check.py, build_smoke.py, dm/ios/tests), so it would fail here for reasons that say nothing about
# the shell. The shell has its own workflow: shell.yml. dm/ios and docs now match upstream 4639c51 otherwise.
.github/workflows/tests.yml
